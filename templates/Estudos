<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Desafios de Python - Complete o Código</title>
  <style>
    :root {
      --bg-color: #f4f7f6;
      --card-bg: #ffffff;
      --primary: #3776ab;
      --primary-hover: #2b5b84;
      --text: #333333;
      --border: #cccccc;
      --success: #28a745;
      --error: #dc3545;
      --easy: #28a745;
      --medium: #fd7e14;
      --hard: #dc3545;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    body {
      background-color: var(--bg-color);
      color: var(--text);
      padding: 20px;
      display: flex;
      justify-content: center;
    }

    .container {
      max-width: 800px;
      width: 100%;
    }

    header {
      text-align: center;
      margin-bottom: 25px;
    }

    header h1 {
      color: var(--primary);
      margin-bottom: 8px;
    }

    .quiz-card {
      background-color: var(--card-bg);
      border-radius: 8px;
      padding: 20px;
      margin-bottom: 20px;
      box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
      position: relative;
    }

    .card-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 15px;
    }

    .badge {
      padding: 4px 12px;
      border-radius: 12px;
      color: #fff;
      font-size: 0.85rem;
      font-weight: bold;
      text-transform: uppercase;
    }

    .badge.fácil { background-color: var(--easy); }
    .badge.intermediário { background-color: var(--medium); }
    .badge.difícil { background-color: var(--hard); }

    .question-title {
      font-size: 1.1rem;
      font-weight: 600;
      margin-bottom: 12px;
    }

    pre {
      background-color: #272822;
      color: #f8f8f2;
      padding: 15px;
      border-radius: 6px;
      overflow-x: auto;
      font-family: 'Consolas', 'Courier New', Courier, monospace;
      font-size: 0.95rem;
      line-height: 1.5;
      margin-bottom: 15px;
    }

    input.blank {
      background-color: #3e3d32;
      border: 1px solid var(--primary);
      color: #a6e22e;
      font-family: inherit;
      font-size: inherit;
      padding: 2px 6px;
      border-radius: 4px;
      width: 100px;
      text-align: center;
      font-weight: bold;
    }

    input.blank:focus {
      outline: 2px solid #66d9ef;
    }

    .actions {
      display: flex;
      gap: 10px;
      align-items: center;
    }

    button {
      background-color: var(--primary);
      color: white;
      border: none;
      padding: 8px 16px;
      border-radius: 4px;
      cursor: pointer;
      font-weight: bold;
      transition: background-color 0.2s;
    }

    button:hover {
      background-color: var(--primary-hover);
    }

    .feedback {
      font-weight: bold;
      padding: 6px 12px;
      border-radius: 4px;
      display: none;
    }

    .feedback.correct {
      display: inline-block;
      color: var(--success);
      background-color: #e6f4ea;
    }

    .feedback.incorrect {
      display: inline-block;
      color: var(--error);
      background-color: #fce8e6;
    }
  </style>
</head>
<body>

  <div class="container">
    <header>
      <h1>Desafios de Python</h1>
      <p>Preencha as lacunas no código para resolver os problemas de lógica.</p>
    </header>

    <div id="quiz-container"></div>
  </div>

  <script>
    // Banco de dados de questões
    const questions = [
      {
        id: 1,
        difficulty: "fácil",
        title: "1. Imprimir números pares de 0 a 8",
        code: `for i in range(10):\n    if i % 2 ___ 0:\n        print(i)`,
        answers: ["=="]
      },
      {
        id: 2,
        difficulty: "fácil",
        title: "2. Adicionar elemento ao final da lista",
        code: `frutas = ["maçã", "banana"]\nfrutas.___("laranja")`,
        answers: ["append"]
      },
      {
        id: 3,
        difficulty: "intermediário",
        title: "3. Calcular o fatorial de um número usando recursão",
        code: `def fatorial(n):\n    if n == 0 or n == 1:\n        return 1\n    return n * ___(n - 1)`,
        answers: ["fatorial"]
      },
      {
        id: 4,
        difficulty: "intermediário",
        title: "4. Trocar os valores de duas variáveis",
        code: `a = 5\nb = 10\na, b = ___, ___`,
        answers: ["b", "a"]
      },
      {
        id: 5,
        difficulty: "difícil",
        title: "5. Inverter uma string usando List Slicing",
        code: `texto = "Python"\ntexto_invertido = texto[___]`,
        answers: ["::-1"]
      },
      {
        id: 6,
        difficulty: "difícil",
        title: "6. Mapear quadrados usando List Comprehension",
        code: `numeros = [1, 2, 3, 4]\nquadrados = [x**2 ___ x ___ numeros if x % 2 != 0]`,
        answers: ["for", "in"]
      }
    ];

    function renderQuiz() {
      const container = document.getElementById("quiz-container");

      questions.forEach((q, qIndex) => {
        const card = document.createElement("div");
        card.className = "quiz-card";

        // Substitui a marcação ___ por um campo de input com a classe "blank"
        let answerCounter = 0;
        const formattedCode = q.code.replace(/___/g, () => {
          const inputHtml = `<input type="text" class="blank" data-q="${qIndex}" data-a="${answerCounter}" autocomplete="off" spellcheck="false">`;
          answerCounter++;
          return inputHtml;
        });

        card.innerHTML = `
          <div class="card-header">
            <span class="question-title">${q.title}</span>
            <span class="badge ${q.difficulty}">${q.difficulty}</span>
          </div>
          <pre><code>${formattedCode}</code></pre>
          <div class="actions">
            <button onclick="checkAnswer(${qIndex})">Verificar</button>
            <span id="feedback-${qIndex}" class="feedback"></span>
          </div>
        `;

        container.appendChild(card);
      });
    }

    function checkAnswer(questionIndex) {
      const q = questions[questionIndex];
      const inputs = document.querySelectorAll(`input[data-q="${questionIndex}"]`);
      const feedbackEl = document.getElementById(`feedback-${questionIndex}`);
      
      let allCorrect = true;

      inputs.forEach((input) => {
        const answerIndex = parseInt(input.getAttribute("data-a"));
        const userAnswer = input.value.trim();
        const expectedAnswer = q.answers[answerIndex];

        // Comparação exata (sensível a maiúsculas/minúsculas)
        if (userAnswer !== expectedAnswer) {
          allCorrect = false;
        }
      });

      if (allCorrect) {
        feedbackEl.textContent = "Acertou! Parabéns!";
        feedbackEl.className = "feedback correct";
      } else {
        feedbackEl.textContent = "Tente novamente.";
        feedbackEl.className = "feedback incorrect";
      }
    }

    // Inicializa o quiz na página
    renderQuiz();
  </script>
</body>
</html>